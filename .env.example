# Required: Google Gemini API key (free at https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Optional model override (default: gemini-flash-latest).
# If the free tier is congested (503 "high demand"), gemini-flash-lite-latest is faster.
# AUDIT_MODEL=gemini-flash-lite-latest

# --- Optional: Anthropic Claude instead of Gemini ---
# Needs: pip install -r requirements-anthropic.txt
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AUDIT_MODEL=claude-opus-5-5
# AUDIT_EFFORT=high
