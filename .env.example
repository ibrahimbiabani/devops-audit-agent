# Required: Google Gemini API key (free at https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# By default the agent builds its model chain from every general-purpose text model the key
# can use, most capable first (Pro, then Flash, then Flash-Lite, then Gemma; newest first;
# gemini-3.8-flash and gemini-3.7-flash are left out as too often overloaded),
# and moves down the chain when a model is out of quota, overloaded or retired.

# Optional: try this model first, before the chain.
# AUDIT_MODEL=gemini-3.6-flash

# Optional: use this exact chain instead of discovering it (comma-separated),
# or "none" to use only AUDIT_MODEL.
# AUDIT_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# Optional: where unavailable models, daily limits and today's request counts are kept
# between runs ("none" disables).
# Default: ~/.cache/devops-audit-agent/gemini-model-status.json
# AUDIT_MODEL_STATUS_FILE=

# --- Optional: Anthropic Claude instead of Gemini ---
# Needs: pip install -r requirements-anthropic.txt
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AUDIT_MODEL=claude-opus-5-5
# AUDIT_EFFORT=high
