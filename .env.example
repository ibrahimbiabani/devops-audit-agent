# Required: Google Gemini API key (free at https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Optional: primary model (default: gemini-3.5-flash-lite).
# AUDIT_MODEL=gemini-3.5-flash-lite

# Optional: models tried in order when the current one is overloaded (503),
# out of quota (429) or retired (404). Comma-separated, or "none" to disable.
# Default: gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3-flash-preview
# AUDIT_FALLBACK_MODELS=

# --- Optional: Anthropic Claude instead of Gemini ---
# Needs: pip install -r requirements-anthropic.txt
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AUDIT_MODEL=claude-opus-5-5
# AUDIT_EFFORT=high
