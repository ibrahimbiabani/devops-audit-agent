# Set ONE of these. The provider is picked from whichever key is present,
# or set LLM_PROVIDER explicitly.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional: anthropic | gemini
# LLM_PROVIDER=

# Optional model override. Defaults: claude-opus-5-5 (anthropic), gemini-flash-latest (gemini).
# AUDIT_MODEL=

# Optional, anthropic only: low | medium | high | xhigh | max
# AUDIT_EFFORT=high
